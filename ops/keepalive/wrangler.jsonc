{
  "name": "stoqo-api-keepalive",
  "account_id": "58054f815326dcff5b1d0efaa91da525",
  "main": "worker.js",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": {
    // UTC: 01:30–17:20 = 07:00–22:50 IST. Let the API sleep overnight.
    "crons": ["30,40,50 1 * * *", "*/10 2-16 * * *", "0,10,20 17 * * *"]
  }
}
