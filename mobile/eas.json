{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "local" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "preview": {
      "distribution": "internal",
      "env": { "STOQO_RELEASE_BUILD": "true" },
      "android": { "buildType": "apk" }
    },
    "apk": { "extends": "preview" },
    "production": {
      "env": { "STOQO_RELEASE_BUILD": "true" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": { "production": {} }
}
