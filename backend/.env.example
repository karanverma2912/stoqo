RAILS_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stoqo_development
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/stoqo_test
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
PORT=3001
# Production: generate with bundle exec rails secret
SECRET_KEY_BASE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
# Free pilot uses PostgreSQL for jobs, cable and limited file uploads
DATABASE_SCHEMA=public
DATABASE_POOL=12
JOB_ADAPTER=solid_queue
SOLID_QUEUE_IN_PUMA=true
SOLID_QUEUE_SUPERVISOR_MODE=async
STORAGE_SERVICE=database
UPLOAD_DATABASE_LIMIT_BYTES=104857600
WEB_URL=https://your-stoqo-website.example
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DAILY_CALL_LIMIT=50
MAIL_DELIVERY_ENABLED=false
MAIL_FROM=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
REQUIRE_EMAIL_VERIFICATION=false
RELEASE_SIGNING_ENABLED=false
STOQO_FREE_PILOT=false
