EXPO_PUBLIC_API_URL=https://YOUR-STOQO-API.onrender.com
EXPO_PUBLIC_WEB_URL=https://YOUR-STOQO-WEB.onrender.com
# For EAS APK/AAB builds, configure live origins here or in production.json.
# Local development may use an HTTP API; release builds require public HTTPS.
# Public Expo project identifier, not an API secret:
EXPO_PUBLIC_EAS_PROJECT_ID=
# Local path to Android Firebase client configuration when enabling remote push:
GOOGLE_SERVICES_JSON=
